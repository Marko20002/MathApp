# Development example. Never put real credentials in this file.
DEBUG=True
SECRET_KEY=replace-with-a-random-private-secret
# Use your local PostgreSQL URL; hosted URLs should require TLS.
DATABASE_URL=postgresql://mathapp:CHANGE_ME@127.0.0.1:55432/mathapp
ML_MODEL_PATH=models/baseline-v1/classifier.joblib
ML_CONFIDENCE_THRESHOLD=0.60
ML_CONFIDENCE_MARGIN=0.15
# Server secret: never put this in frontend code, Git, or screenshots.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=3500
OPENAI_TIMEOUT_SECONDS=45
# Keep true locally; set false on Railway until invited accounts are implemented.
ALLOW_PUBLIC_REGISTRATION=true
ALLOWED_HOSTS=localhost,127.0.0.1
